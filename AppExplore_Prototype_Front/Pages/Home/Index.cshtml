@page
@model AppExplore_Prototype_Front.Pages.Home.IndexModel
@{
    ViewData["Title"] = "AppExplore Prototype";
}
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="filter-panel">

    <!-- HEADER -->
    <h1>Discover Apps</h1>

    <!-- SEARCH BAR (inside panel for visual consistency) -->
    <div class="search-container">
        <input type="text"
               name="SearchQuery"
               placeholder="Search apps..."
               class="search-input" />
    </div>

    <!-- CATEGORY (NOT part of form) -->
    <div class="filter-section">
        <h3>Category</h3>

        <select id="categorySelect">
            <option value="">Select Category</option>
            @foreach (var cat in Model.SupportedCategories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <!-- FORM ONLY FOR FINAL SUBMIT -->
    <form method="get" asp-page="/Home/Results">

        <input type="hidden" name="SelectedCategory" id="hiddenCategory" />

        <h3>Features</h3>
        @foreach (var type in Model.SupportedTypes)
        {
            <div>
                <input type="checkbox" name="SelectedTypes" value="@type" />
                <label>@type</label>
            </div>
        }

        <h3>Tags</h3>
        <p id="tagMessage">Select a Category to see relevant tags!</p>

        <div id="tagContainer"></div>

        <button type="submit" class="btn btn-primary">
            Explore!
        </button>

    </form>

</div>

<script>
    
    document.getElementById("categorySelect").addEventListener("change", async function () {

        const category = this.value;

        // =====================================================
        // 1) KEEP CATEGORY SYNCED FOR FORM SUBMISSION
        // =====================================================
        const hiddenCategory = document.getElementById("hiddenCategory");
        if (hiddenCategory) {
            hiddenCategory.value = category;
        }

        // =====================================================
        // 2) LIVE TAG LOADING (UNCHANGED FUNCTIONALITY)
        // =====================================================
        const response = await fetch(`?handler=Tags&category=${category}`);
        const tags = await response.json();

        const container = document.getElementById("tagContainer");
        const message = document.getElementById("tagMessage");

        container.innerHTML = "";

        // Handle empty category or no tags
        if (!category || tags.length === 0) {
            message.style.display = "block";
            message.innerText = "Select a Category to see relevant tags!";
            return;
        }

        message.style.display = "none";

        // Render checkboxes
        tags.forEach(tag => {
            container.innerHTML += `
                <div>
                    <input type="checkbox" name="SelectedTags" value="${tag}" />
                    <label>${tag}</label>
                </div>
            `;
        });
    });
</script>