@page "{id:int}"
@model AppExplore_Prototype_Front.Pages.Home.DetailsModel
@{
    ViewData["Title"] = "App Details";
}

<div class="app-details-container">

    <!-- HEADER SECTION -->
    <div class="app-header">

        <div class="app-logo">
            <img src="@Model.ImageConnectionString@Model.App.ImageUrl" alt="@Model.App.Title logo" />
        </div>

        <div class="app-title-block">
            <h1 class="app-title">@Model.App.Title</h1>
            <span class="app-category">@Model.App.Category</span>
        </div>

    </div>

    <!-- DESCRIPTION -->
    <div class="app-section">
        <h3>Description</h3>
        <p>@Model.App.Description</p>
    </div>

    <!-- TYPES -->
    <div class="app-section">
        <h3>Types</h3>
        <div class="tag-row">
            @foreach (var type in Model.App.Type)
            {
                <span class="pill type-pill">@type</span>
            }
        </div>
    </div>

    <!-- TAGS -->
    <div class="app-section">
        <h3>Tags</h3>
        <div class="tag-row">
            @foreach (var tag in Model.App.Tags)
            {
                <span class="pill tag-pill">@tag</span>
            }
        </div>
    </div>

</div>