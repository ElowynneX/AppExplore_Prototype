@model AppExplore_API_Prototype.Model.AppModel

@{
    ViewData["Title"] = Model.Title;
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="my-5">
    <a href="@Url.Action("Index", "AppMvc")" class="btn btn-secondary mb-4">← Back</a>

    <div class="card p-4 shadow-sm">
        <h2>@Model.Title</h2>
        <p><strong>Developer:</strong> @Model.Developer</p>
        <p><strong>Category:</strong> @Model.Category</p>
        <p><strong>Rating:</strong> @Model.Rating / 5</p>
        <p><strong>Description:</strong></p>
        <p>@Model.Description</p>
        <p><strong>Type:</strong> @string.Join(", ", Model.Type)</p>
        <p class="tags">
            <strong>Tags:</strong>
            @foreach (var tag in Model.Tags)
            {
                <span>@tag</span>
            }
        </p>
    </div>
</div>